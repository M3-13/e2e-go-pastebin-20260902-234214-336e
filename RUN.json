{
  "runcontract": 1,
  "services": [
    {
      "name": "pastebin",
      "dir": ".",
      "stack": "go",
      "kind": "server",
      "build": [["go", "build", "./..."]],
      "start": ["go", "run", "."],
      "port": 8080,
      "port_env": "PORT",
      "health": { "path": "/health", "expect_status": [200] },
      "env": {
        "SERVER_ADDR": { "dev": "localhost:8080" }
      }
    }
  ]
}
